{
  "name": "@saas/agent-runtime-worker-tests",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "lint": "eslint src"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250508.0",
    "@saas/eslint-config": "workspace:*",
    "@saas/tsconfig": "workspace:*",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.15.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.3.4",
    "typescript": "^5.8.3",
    "@jest/globals": "^29.7.0"
  },
  "dependencies": {
    "@ai-sdk/policy-opa": "1.0.179",
    "@open-policy-agent/opa-wasm": "1.10.0",
    "@saas/agent-core": "workspace:*",
    "@saas/agent-runtime-worker": "workspace:*",
    "@saas/contracts": "workspace:*",
    "@saas/db": "workspace:*",
    "@saas/worker-kit": "workspace:*",
    "ai": "7.0.179"
  },
  "jest": {
    "preset": "ts-jest/presets/default-esm",
    "extensionsToTreatAsEsm": [
      ".ts"
    ],
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.js$": "$1",
      "^@saas/contracts$": "<rootDir>/../../packages/contracts/src/index.ts",
      "^@saas/contracts/(.*)$": "<rootDir>/../../packages/contracts/src/$1.ts",
      "^@agent-runtime-worker/(.*)$": "<rootDir>/../../apps/agent-runtime-worker/src/$1.ts",
      "^cloudflare:workers$": "<rootDir>/src/cf-workers-stub.ts",
      "\\.wasm$": "<rootDir>/src/wasm-stub.ts",
      "^@saas/worker-kit$": "<rootDir>/../../packages/worker-kit/src/index.ts",
      "^@saas/agent-core/(.*)$": "<rootDir>/../../packages/agent-core/src/$1.ts",
      "^@saas/db$": "<rootDir>/../../packages/db/src/index.ts",
      "^@saas/db/manifest$": "<rootDir>/../../packages/db/src/manifest.ts",
      "^@saas/db/types$": "<rootDir>/../../packages/db/src/types.ts",
      "^@saas/db/(.*)$": "<rootDir>/../../packages/db/src/$1/index.ts",
      "^@saas/agent-core$": "<rootDir>/../../packages/agent-core/src/index.ts",
      "^just-bash$": "<rootDir>/../../apps/agent-runtime-worker/src/vendor/just-bash.js"
    },
    "transform": {
      "^.+\\.ts$": [
        "ts-jest",
        {
          "useESM": true
        }
      ]
    },
    "testMatch": [
      "<rootDir>/src/**/*.test.ts"
    ],
    "transformIgnorePatterns": [
      "/node_modules/"
    ]
  }
}
