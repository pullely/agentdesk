// Rendered to wrangler.jsonc by tooling/wire/render.mjs (BF6 deploy-time wiring).
// Resource IDs are NEVER committed: @@wiring(<component>/<env>:<key>)@@ tokens are
// resolved from the workspace's orun secrets at deploy time (wire-live) or from the
// committed wiring.fixture.json for offline dry-runs (wire-fixture).
{
  "name": "agentdesk-bots-worker",
  "compatibility_date": "2025-05-01",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/index.ts",
  "minify": false,
  "vars": {
    "ENVIRONMENT": "local"
  },
  "env": {
    "dev": {
      "vars": {
        "ENVIRONMENT": "dev"
      }
    },
    "stage": {
      "workers_dev": false,
      "vars": {
        "ENVIRONMENT": "stage"
      },
      "d1_databases": [
        {
          "binding": "PLATFORM_DB",
          "database_name": "agentdesk-stage",
          "database_id": "00000000000000000000000000000001"
        }
      ],
      "services": [
        { "binding": "MEMBERSHIP_WORKER", "service": "agentdesk-membership-worker-stage" },
        { "binding": "POLICY_WORKER", "service": "agentdesk-policy-worker-stage" },
        { "binding": "AGENT_RUNTIME", "service": "agentdesk-agent-runtime-worker-stage" }
      ]
    },
    "prod": {
      "workers_dev": false,
      "vars": {
        "ENVIRONMENT": "prod"
      },
      "d1_databases": [
        {
          "binding": "PLATFORM_DB",
          "database_name": "agentdesk-prod",
          "database_id": "00000000000000000000000000000003"
        }
      ],
      "services": [
        { "binding": "MEMBERSHIP_WORKER", "service": "agentdesk-membership-worker-prod" },
        { "binding": "POLICY_WORKER", "service": "agentdesk-policy-worker-prod" },
        { "binding": "AGENT_RUNTIME", "service": "agentdesk-agent-runtime-worker-prod" }
      ]
    }
  }
}
