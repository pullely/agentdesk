// Rendered to wrangler.jsonc by tooling/wire/render.mjs (BF6 deploy-time wiring).
// Resource IDs are NEVER committed: @@wiring(<component>/<env>:<key>)@@ tokens are
// resolved from the workspace's orun secrets at deploy time (wire-live) or from the
// committed wiring.fixture.json for offline dry-runs (wire-fixture).
//
// Runtime secrets (pushed by the secrets-live step, component.yaml runtimeSecrets):
// VAULT_KEK_V1 (decrypts BYOK keys, Slack tokens, MCP tokens) and
// CLOUDFLARE_ACCOUNT_ID (BYOK calls through AI Gateway).
{
  "name": "agentdesk-agent-runtime-worker",
  "compatibility_date": "2025-05-01",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/index.ts",
  "minify": false,
  "alias": {
    "just-bash": "./src/vendor/just-bash.js"
  },
  "vars": {
    "ENVIRONMENT": "local"
  },
  "ai": { "binding": "AI" },
  "durable_objects": {
    "bindings": [{ "name": "THREAD_AGENT", "class_name": "ThreadAgent" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ThreadAgent"] }],
  "env": {
    "dev": {
      "vars": {
        "ENVIRONMENT": "dev"
      },
      "ai": { "binding": "AI" },
      "durable_objects": {
        "bindings": [{ "name": "THREAD_AGENT", "class_name": "ThreadAgent" }]
      },
      "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ThreadAgent"] }]
    },
    "stage": {
      "workers_dev": false,
      "vars": {
        "ENVIRONMENT": "stage",
        "AI_GATEWAY_ID": "agentdesk-stage"
      },
      "ai": { "binding": "AI" },
      "d1_databases": [
        {
          "binding": "PLATFORM_DB",
          "database_name": "agentdesk-stage",
          "database_id": "00000000000000000000000000000001"
        }
      ],
      "durable_objects": {
        "bindings": [{ "name": "THREAD_AGENT", "class_name": "ThreadAgent" }]
      },
      "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ThreadAgent"] }],
      "services": [
        { "binding": "CONNECTORS_WORKER", "service": "agentdesk-connectors-worker-stage" }
      ]
    },
    "prod": {
      "workers_dev": false,
      "vars": {
        "ENVIRONMENT": "prod",
        "AI_GATEWAY_ID": "agentdesk-prod"
      },
      "ai": { "binding": "AI" },
      "d1_databases": [
        {
          "binding": "PLATFORM_DB",
          "database_name": "agentdesk-prod",
          "database_id": "00000000000000000000000000000003"
        }
      ],
      "durable_objects": {
        "bindings": [{ "name": "THREAD_AGENT", "class_name": "ThreadAgent" }]
      },
      "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ThreadAgent"] }],
      "services": [
        { "binding": "CONNECTORS_WORKER", "service": "agentdesk-connectors-worker-prod" }
      ]
    }
  }
}
